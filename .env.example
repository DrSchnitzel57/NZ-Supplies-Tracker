# Copy to .env on the host (gitignored). Never commit real secrets.
# Synthetic placeholders only; production values are set by the operator.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=192.168.1.10
DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.1.10:8443
DJANGO_DB_PATH=/app/data/db.sqlite3
# Time zone for dates shown in the app (IANA name). Default: Pacific/Auckland.
DJANGO_TIME_ZONE=Pacific/Auckland
# Fixed LAN address/port Caddy binds (no public exposure).
APP_HOST=192.168.1.10
APP_PORT=8443
# Pinned release image (private GHCR). Host pulls; never builds source.
# VERSION is the single canonical pin: image tag and APP_VERSION both derive
# from it (see compose.yaml). A release tag vX.Y.Z publishes both vX.Y.Z and
# X.Y.Z so this pin always resolves. IMAGE_BASE names the repository WITHOUT
# a tag; the running image is always IMAGE_BASE:VERSION. Legacy IMAGE is
# honored as a fallback for existing hosts but must also be tagless.
IMAGE_BASE=ghcr.io/example/supplies-tracker
VERSION=0.4.0
# Read-only registry pull credential for the host (least privilege).
# Set via `docker login ghcr.io` on the host, not in this file.
